# macOS
.DS_Store
.AppleDouble
.LSOverride

# Obsidian - ephemeral state (don't version these)
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/cache
**/.obsidian/graph.json

# Obsidian - plugin compiled files (large blobs, reinstallable)
# manifest.json is kept - it records which plugins/versions are installed
**/.obsidian/plugins/*/main.js
**/.obsidian/plugins/*/styles.css

# Personal meta (local only)
linux-notes/_meta/WRITING-STYLE.md

# Blue Topaz theme CSS (local only): MIT itself, but it embeds Font Awesome
# Pro icons under a commercial license that doesn't allow redistributing
# them here. manifest.json stays; install the theme from Obsidian.
linux-notes/.obsidian/themes/Blue Topaz/theme.css
